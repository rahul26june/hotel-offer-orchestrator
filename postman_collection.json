  "item": [
    {
      "name": "Get Hotels - Overlap City",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/api/hotels?city=delhi",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
